# Tableau Cloud connection — identical env vars to the official @tableau/mcp-server,
# so the same MCP client config works for both servers side by side.

# Full site URL, e.g. https://10ax.online.tableau.com  (or your pod / Server URL)
SERVER=https://my-pod.online.tableau.com

# Site content URL (the part after /site/ in the browser URL). Use an empty string for Default.
SITE_NAME=mysite

# Personal Access Token — create under Account Settings → Personal Access Tokens.
PAT_NAME=my_pat
PAT_VALUE=replace-me-never-commit-the-real-value

# Optional. Tableau REST API version. Defaults to 3.28.
# TABLEAU_API_VERSION=3.28

# Optional. Localhost port for the Python authoring sidecar.
# Defaults to an automatically-chosen free port; set only to pin a specific port.
# SIDECAR_PORT=8899

# Optional. Target project for `npm run demo` (must exist; not the Default project).
# DEMO_PROJECT=Sales
