{
  "name": "tableau-mcp-publish",
  "version": "0.1.0",
  "description": "MCP server for authoring + publishing on Tableau Cloud — the write side the official Tableau MCP doesn't cover.",
  "type": "module",
  "license": "MIT",
  "author": "Sebastien Henry",
  "homepage": "https://github.com/SebAustin/tableau-mcp-publish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebAustin/tableau-mcp-publish.git"
  },
  "keywords": [
    "tableau",
    "mcp",
    "model-context-protocol",
    "tableau-cloud",
    "hyper-api",
    "tableau-rest-api",
    "data-publishing",
    "bi"
  ],
  "bin": {
    "tableau-mcp-publish": "./dist/index.js"
  },
  "files": [
    "dist",
    "brand.yaml",
    "sidecar/*.py",
    "sidecar/pyproject.toml",
    "sidecar/uv.lock"
  ],
  "engines": {
    "node": ">=22.7.5"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "demo:dashboard": "tsx scripts/demo-dashboard.ts",
    "demo:superstore": "tsx scripts/demo-superstore.ts",
    "test:mcp-smoke": "tsx scripts/mcp-smoke.ts",
    "verify-setup": "tsx scripts/verify-setup.ts",
    "refresh:local": "tsx scripts/refresh-local.ts",
    "cron:generate": "tsx scripts/generate-cron.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "undici": "7.28.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  }
}
